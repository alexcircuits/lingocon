# Anonymous statistics beacon (app/api/stats): one request per page view plus a ping every
# 25 s per open tab. Bounds what one address can send before it reaches the app, which also
# rate-limits per process (lib/stats/throttle.ts, app/api/stats/route.ts).
limit_req_zone $binary_remote_addr zone=lingocon_stats:10m rate=10r/s;

server {
    listen 80;
    server_name lingocon.com www.lingocon.com;

    # Redirect HTTP to HTTPS (uncomment after getting SSL with certbot)
    # return 301 https://$host$request_uri;

    # Allow larger uploads (e.g. CSV dictionary imports). nginx defaults to 1m,
    # which makes uploads over ~1 MB fail with a 413 HTML error page. Keep this
    # at or below the app's route maxDuration/body expectations.
    client_max_body_size 25M;

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_cache_bypass $http_upgrade;

        # The CSV import route allows up to 60s (maxDuration = 60). Give the
        # proxy matching headroom so large imports don't 504 mid-request.
        proxy_read_timeout 120s;
        proxy_send_timeout 120s;
    }

    location = /api/stats {
        limit_req zone=lingocon_stats burst=40 nodelay;
        limit_req_status 429;
        client_max_body_size 4k;
        # The beacon fires on every page; logging it would only collect more IP addresses.
        access_log off;
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # The Rust platform service (lingocon-api, 127.0.0.1:3040) is internal: Next.js
    # calls it over loopback with a bearer token. Do NOT proxy it here. If pages are
    # later served by it directly, proxy only those public paths (never /v1/internal/)
    # and keep the service bound to loopback. See docs/RUST_SERVICE.md.

    # Served directly by nginx, so the headers next.config.js sets for
    # /uploads/* never apply here — repeat them. Without CSP sandbox + nosniff,
    # an uploaded SVG opened directly runs script on the lingocon.com origin.
    location /uploads/ {
        alias /var/www/lingocon/public/uploads/;
        expires 30d;
        access_log off;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Content-Security-Policy "default-src 'none'; sandbox; style-src 'unsafe-inline'" always;
    }
}

server {
    listen 80;
    server_name analytics.lingocon.com;

    location / {
        proxy_pass http://127.0.0.1:44873;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
