# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js

# testing
/coverage

# next.js
/.next/
# Builds into another directory (NEXT_DIST_DIR), e.g. local probe builds
/.next-*/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env
.env*.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts


/lib/generated/prisma


# Public — ignore only runtime-uploaded user content. The static brand assets
# (icons/, manifest.json, llms.txt, sw.js, fonts/) MUST stay tracked, otherwise
# they never reach the server via `git push vps` and 404 in production —
# breaking the Organization-schema logo, apple-touch-icon, PWA manifest, etc.
/public/uploads
/public/uploads_backup*

#scripts (keep setup.sh tracked for npm run setup)
/scripts/*
!/scripts/setup.sh
# Rust/TypeScript parity fixtures generator + its freshness test (run by npm test).
!/scripts/rust-parity/
!/scripts/bench-overview-analysis.ts
build_log.txt

nginx.conf.example

# Playwright
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/
# Session cookies of the E2E fixture accounts (e2e/auth.setup.ts)
/e2e/.auth/

# Release-per-deploy build output (deploy.sh)
/.next-releases/
/.next-release

# Rust workspace build output
/rust/target/
