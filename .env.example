# Development Mode (No Auth Required)
DEV_MODE="true"

# Database (Required)
# Docker Compose default (see SETUP.md — npm run setup starts Postgres for you):
# DATABASE_URL="postgresql://langua:langua@localhost:5432/langua?schema=public"
# Or your own Postgres:
DATABASE_URL="postgresql://user:password@localhost:5432/langua?schema=public"
# Production with PM2 cluster mode (ecosystem.config.js, one web worker per CPU):
# every worker opens its own Prisma pool of 2×CPUs+1 connections by default, so
# 8 CPUs ask for 8×17 = 136 connections — more than PostgreSQL's default
# max_connections (100). Exhausted pools show up as slow saves and timeouts.
# Cap each worker so workers × connection_limit stays below max_connections, e.g.:
# DATABASE_URL="postgresql://user:password@host:5432/langua?schema=public&connection_limit=8&pool_timeout=10"

# Loopback origin the Edge middleware uses to look up renamed project slugs on
# full page loads. Defaults to http://127.0.0.1:$PORT; set it if Next listens elsewhere.
# INTERNAL_API_ORIGIN="http://127.0.0.1:3000"

# Canonical public origin — used for canonical <link> tags, Open Graph URLs,
# robots.txt, sitemap.xml and JSON-LD. Localhost is fine for local dev.
#
# IMPORTANT (production): NEXT_PUBLIC_* vars are INLINED AT BUILD TIME. If you
# run `next build` with this set to localhost, every canonical/OG/sitemap URL
# ships pointing at localhost and Google will drop your pages from the index.
# On the server, set this to the real origin BEFORE building, e.g.:
#   NEXT_PUBLIC_SITE_URL="https://lingocon.com"
# Alternatively, set SITE_URL (runtime, server-only — not inlined) to override
# the origin without a rebuild. getSiteUrl() prefers SITE_URL, then
# NEXT_PUBLIC_SITE_URL, and in production refuses to emit a localhost origin.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# SITE_URL="https://lingocon.com"

# ------------------------------------------------------------------
# Production / Full Auth Configuration (Optional for Local Dev)
# ------------------------------------------------------------------

# NextAuth
# AUTH_SECRET="generate-with-openssl-rand-base64-32"
# AUTH_URL="http://localhost:3000"

# GitHub OAuth
# GITHUB_CLIENT_ID="your-github-client-id"
# GITHUB_CLIENT_SECRET="your-github-client-secret"

# Google OAuth
# GOOGLE_CLIENT_ID="your-google-client-id"
# GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Email (Resend) - Required for email verification and password reset
# RESEND_API_KEY="re_xxxxxxxxxxxx"
# EMAIL_FROM="LingoCon <noreply@yourdomain.com>"

# ------------------------------------------------------------------
# Rust platform service (optional) — rust/crates/api, see docs/RUST_SERVICE.md
# ------------------------------------------------------------------
# Next.js authorizes the user, then calls the service over loopback with a shared
# token. Leave LINGOCON_API_URL unset to use the TypeScript implementations (this
# is also the rollback switch). The service reads this same .env file; variables
# already set in the environment win. It also uses DATABASE_URL (Prisma query
# parameters such as schema/connection_limit are understood or ignored) and, for
# session-authenticated routes, AUTH_SECRET.
#
# Read by Next.js. The timeout is per call; on timeout Next falls back to TypeScript.
# LINGOCON_API_URL="http://127.0.0.1:3040"
# LINGOCON_API_TIMEOUT_MS="3000"
#
# Read by both; required by the service. 32–256 printable ASCII characters without
# spaces, e.g. `openssl rand -hex 32`.
# LINGOCON_API_TOKEN=""
#
# Read by the service (defaults shown). A non-loopback LINGOCON_API_BIND is refused
# unless LINGOCON_API_ALLOW_PUBLIC_BIND is 1 (containers / private networks only).
# LINGOCON_API_DB_POOL is per service process: count it against max_connections
# together with the Prisma pools. LINGOCON_API_MAX_INFLIGHT is the number of
# concurrent requests before the service answers 503. The statement timeout must
# stay below the 10 s request timeout (max 9000). RUST_LOG takes filters such as
# "info,lingocon_api=debug". DATABASE_URL with pgbouncer=true is not supported.
# LINGOCON_API_BIND="127.0.0.1:3040"
# LINGOCON_API_ALLOW_PUBLIC_BIND="0"
# LINGOCON_API_DB_POOL="8"
# LINGOCON_API_STATEMENT_TIMEOUT_MS="5000"
# LINGOCON_API_MAX_INFLIGHT="32"
# RUST_LOG="info"